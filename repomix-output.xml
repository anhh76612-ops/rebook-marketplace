  var ROLE_LABELS = {
    KHACH_HANG: 'Khách hàng',
    CHU_CUA_HANG: 'Chủ cửa hàng',
    DON_VI_VAN_CHUYEN: 'Đơn vị vận chuyển',
    QUAN_LY: 'Quản lý',
    QUAN_TRI_VIEN: 'Quản trị viên'
  };

  function lsGet(key) {
    try { return window.localStorage.getItem(key); } catch (e) { return null; }
  }
  function lsSet(key, value) {
    try { window.localStorage.setItem(key, value); } catch (e) { }
  }
  function lsRemove(key) {
    try { window.localStorage.removeItem(key); } catch (e) { }
  }

  function decodePayload(token) {
    try {
      var part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
      while (part.length % 4) { part += '='; }
      return JSON.parse(window.atob(part));
    } catch (e) {
      return null;
    }
  }

  function escapeHtml(value) {
    return String(value === null || value === undefined ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatMoney(value) {
    return Number(value || 0).toLocaleString('en-US') + ' đ';
  }

  function safeRedirect(target, fallback) {
    if (typeof target === 'string'
        && target.charAt(0) === '/'
        && target.charAt(1) !== '/'
        && target.charAt(1) !== '\\') {
      return target;
    }
    return fallback || '/';
  }

  function ApiError(status, message) {
    this.name = 'ApiError';
    this.status = status;
    this.message = message;
  }
  ApiError.prototype = Object.create(Error.prototype);
  ApiError.prototype.constructor = ApiError;

  function defaultMessage(status) {
    if (status === 401) { return 'Phiên đăng nhập không hợp lệ. Vui lòng đăng nhập lại.'; }
    if (status === 403) { return 'Bạn không có quyền thực hiện thao tác này.'; }
    if (status >= 500) { return 'Máy chủ gặp lỗi. Vui lòng thử lại sau.'; }
    return 'Yêu cầu không hợp lệ.';
  }

  var Auth = {

    getToken: function () {
      var token = lsGet(TOKEN_KEY);
      if (!token) { return null; }

      var payload = decodePayload(token);
      if (!payload || !payload.exp || payload.exp * 1000 <= Date.now()) {
        Auth.clear();
        return null;
      }
      return token;
    },

    getUser: function () {
      var token = Auth.getToken();
      if (!token) { return null; }

      var payload = decodePayload(token) || {};
      return {
        maND: payload.maND,
        maTK: payload.maTK,
        vaiTro: payload.vaiTro,
        hoTen: lsGet(NAME_KEY)
      };
    },

    isLoggedIn: function () {
      return Auth.getToken() !== null;
    },

    hasRole: function (role) {
      var user = Auth.getUser();
      return !!user && user.vaiTro === role;
    },

    saveSession: function (loginData) {
      lsSet(TOKEN_KEY, loginData.token);
      lsRemove(NAME_KEY);
    },

    clear: function () {
      lsRemove(TOKEN_KEY);
      lsRemove(NAME_KEY);
    },

    safeRedirect: safeRedirect,

    navigate: function (url) {
      window.location.assign(url);
    },

    loginUrl: function (redirect) {
      var back = redirect || (window.location.pathname + window.location.search);
      return '/login?redirect=' + encodeURIComponent(safeRedirect(back, '/'));
    },

    redirectToLogin: function (redirect) {
      Auth.navigate(Auth.loginUrl(redirect));
    },

    handleAuthError: function (err, requiredRole) {
      if (!(err instanceof ApiError)) { return false; }

      var user = Auth.getUser();
      var wrongRole = !!user && !!requiredRole && user.vaiTro !== requiredRole;
      var sessionInvalid = err.status === 401 || (err.status === 403 && !wrongRole);

      if (!sessionInvalid) { return false; }

      Auth.clear();
      Auth.redirectToLogin();
      return true;
    },

    login: function (email, matKhau) {
      return request('POST', '/api/auth/login', { email: email, matKhau: matKhau }, { token: null });
    },

    selectRole: function (roleSelectionToken, maTK) {
      return request('POST', '/api/auth/select-role', { maTK: maTK }, { token: roleSelectionToken });
    },

    loadProfileName: function () {
      return request('GET', '/api/profile').then(function (profile) {
        if (profile && profile.hoTen) { lsSet(NAME_KEY, profile.hoTen); }
      }, function () { });
    },

    logout: function () {
      var finish = function () {
        Auth.clear();
        Auth.navigate('/');
      };

      if (!Auth.getToken()) { finish(); return; }

      request('POST', '/api/auth/logout').then(finish, finish);
    }
  };

  function request(method, url, body, options) {
    options = options || {};

    var headers = { 'Accept': 'application/json' };
    var token = options.token !== undefined ? options.token : Auth.getToken();
    if (token) { headers['Authorization'] = 'Bearer ' + token; }

    var init = { method: method, headers: headers };
    if (body !== undefined) {
      headers['Content-Type'] = 'application/json';
      init.body = JSON.stringify(body);
    }

    return window.fetch(url, init)
      .catch(function () {
        throw new ApiError(0, 'Không kết nối được máy chủ. Vui lòng thử lại.');
      })
      .then(function (res) {
        return res.text().then(function (text) {
          var json = null;
          if (text) {
            try { json = JSON.parse(text); } catch (e) { json = null; }
          }

          var codeOk = !json || json.code === undefined || json.code === 200 || json.code === 201;

          if (res.ok && codeOk) {
            return json ? json.data : null;
          }

          throw new ApiError(res.status, (json && json.message) || defaultMessage(res.status));
        });
      });
  }

  function toast(message, type, options) {
    options = options || {};

    var holder = document.getElementById('ob-toast-holder');
    if (!holder) {
      holder = document.createElement('div');
      holder.id = 'ob-toast-holder';
      holder.className = 'position-fixed top-0 end-0 p-3';
      holder.style.zIndex = '1100';
      holder.style.maxWidth = '380px';
      document.body.appendChild(holder);
    }

    var box = document.createElement('div');
    box.className = 'alert alert-' + (type || 'info') + ' shadow-sm mb-2';
    box.setAttribute('role', 'alert');

    var text = document.createElement('span');
    text.textContent = message;
    box.appendChild(text);

    if (options.link) {
      var link = document.createElement('a');
      link.href = options.link.href;
      link.className = 'ms-2 fw-semibold';
      link.textContent = options.link.text;
      box.appendChild(link);
    }

    holder.appendChild(box);

    window.setTimeout(function () {
      if (box.parentNode) { box.parentNode.removeChild(box); }
    }, options.duration || 3500);
  }

  function renderHeader() {
    var loggedIn = Auth.isLoggedIn();
    var user = Auth.getUser();

    var guests = document.querySelectorAll('[data-auth="guest"]');
    for (var i = 0; i < guests.length; i++) {
      guests[i].classList.toggle('d-none', loggedIn);
    }

    var users = document.querySelectorAll('[data-auth="user"]');
    for (var j = 0; j < users.length; j++) {
      users[j].classList.toggle('d-none', !loggedIn);
    }

    var label = (user && (user.hoTen || ROLE_LABELS[user.vaiTro])) || 'Tài khoản';
    var names = document.querySelectorAll('[data-user-name]');
    for (var k = 0; k < names.length; k++) {
      names[k].textContent = label;
    }
  }

  document.addEventListener('click', function (e) {
    var guarded = e.target.closest ? e.target.closest('[data-requires-login]') : null;

    if (guarded && !Auth.isLoggedIn()) {
      e.preventDefault();
      e.stopImmediatePropagation();

      var href = guarded.getAttribute('href');
      var redirect = (href && href.charAt(0) === '/') ? href : null;
      Auth.redirectToLogin(redirect);
      return;
    }

    var logout = e.target.closest ? e.target.closest('[data-action="logout"]') : null;
    if (logout) {
      e.preventDefault();
      Auth.logout();
    }
  }, true);

  function init() {
    if (document.body && document.body.hasAttribute('data-page-requires-login') && !Auth.isLoggedIn()) {
      Auth.redirectToLogin();
      return;
    }
    renderHeader();
  }

  window.OldBook = {
    auth: Auth,
    request: request,
    ApiError: ApiError,
    toast: toast,
    renderHeader: renderHeader,
    escapeHtml: escapeHtml,
    formatMoney: formatMoney,
    roleLabels: ROLE_LABELS,
    ROLE_CUSTOMER: ROLE_CUSTOMER
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</file>

<file path="src/main/resources/static/js/cart.js">
(function () {
  'use strict';

  var OB = window.OldBook;
  if (!OB || OB.cart) { return; }

  var Auth = OB.auth;
  var ROLE = OB.ROLE_CUSTOMER;
  var BASE = '/api/order/cart';

  var Cart = {

    get: function () {
      return OB.request('GET', BASE);
    },

    add: function (maSach, soLuong) {
      return OB.request('POST', BASE + '/items', { maSach: maSach, soLuong: soLuong || 1 });
    },

    update: function (maCTGioHang, soLuong) {
      return OB.request('PUT', BASE + '/items/' + encodeURIComponent(maCTGioHang), { soLuong: soLuong });
    },

    remove: function (maCTGioHang) {
      return OB.request('DELETE', BASE + '/items/' + encodeURIComponent(maCTGioHang));
    },

    clear: function () {
      return OB.request('DELETE', BASE);
    },

    setBadge: function (count) {
      var badges = document.querySelectorAll('.cart-count');
      for (var i = 0; i < badges.length; i++) {
        badges[i].textContent = String(count || 0);
      }
    },

    refreshBadge: function () {
      if (!Auth.isLoggedIn() || !Auth.hasRole(ROLE)) {
        Cart.setBadge(0);
        return;
      }

      Cart.get().then(function (cart) {
        Cart.setBadge(cart.soMuc);
      }, function (err) {
        if (err.status === 401 || err.status === 403) {
          Auth.clear();
          OB.renderHeader();
        }
        Cart.setBadge(0);
      });
    }
  };

  OB.cart = Cart;

  function setLoading(btn, loading) {
    if (loading) {
      btn.disabled = true;
      btn.setAttribute('data-original-html', btn.innerHTML);
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Đang thêm...';
    } else {
      btn.disabled = false;
      var original = btn.getAttribute('data-original-html');
      if (original !== null) { btn.innerHTML = original; }
    }
  }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest ? e.target.closest('[data-add-to-cart]') : null;
    if (!btn) { return; }

    e.preventDefault();
    if (btn.disabled) { return; }

    if (!Auth.isLoggedIn()) {
      Auth.redirectToLogin();
      return;
    }

    if (!Auth.hasRole(ROLE)) {
      OB.toast('Chỉ tài khoản khách hàng mới dùng được giỏ hàng. Vui lòng đăng nhập bằng tài khoản khách hàng.', 'warning', { duration: 5000 });
      return;
    }

    var maSach = parseInt(btn.getAttribute('data-ma-sach'), 10);
    var soLuong = parseInt(btn.getAttribute('data-so-luong') || '1', 10);

    if (!maSach || !soLuong || soLuong < 1) {
      OB.toast('Không xác định được sách cần thêm.', 'danger');
      return;
    }

    setLoading(btn, true);

    Cart.add(maSach, soLuong).then(function (cart) {
      Cart.setBadge(cart.soMuc);
      OB.toast('Đã thêm sách vào giỏ hàng.', 'success', { link: { text: 'Xem giỏ hàng', href: '/cart' } });
    }).catch(function (err) {
      if (Auth.handleAuthError(err, ROLE)) { return; }
      OB.toast(err.message, 'danger', { duration: 5000 });
    }).then(function () {
      setLoading(btn, false);
    });
  });

  function init() {
    Cart.refreshBadge();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</file>

<file path="src/main/resources/static/js/catalog.js">
(function () {
  'use strict';

  var OB = window.OldBook;
  var grid = document.getElementById('bookGrid');

  if (!OB || !grid) { return; }

  var esc = OB.escapeHtml;

  function $(id) { return document.getElementById(id); }
  function show(id) { $(id).classList.remove('d-none'); }
  function hide(id) { $(id).classList.add('d-none'); }

  function safeImg(url) {
    if (!url) { return null; }
    if (/^https?:\/\//i.test(url)) { return url; }
    if (url.charAt(0) === '/' && url.charAt(1) !== '/') { return url; }
    return null;
  }

  function params() {
    var sp = new window.URLSearchParams(window.location.search);
    return {
      q: (sp.get('q') || '').trim(),
      category: (sp.get('category') || '').trim()
    };
  }

  function buildUrl(p) {
    var parts = [];
    if (p.q) { parts.push('q=' + encodeURIComponent(p.q)); }
    if (p.category) { parts.push('category=' + encodeURIComponent(p.category)); }
    return '/api/sach' + (parts.length ? '?' + parts.join('&') : '');
  }

  function cardHtml(b) {
    var ton = b.soLuongTon || 0;
    var conHang = ton > 0;
    var img = safeImg(b.hinhAnhUrl);

    var cover = img
      ? '<div class="cover" style="padding:0">' +
          '<img src="' + esc(img) + '" alt="' + esc(b.tenSach) + '" ' +
          'style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">' +
        '</div>'
      : '<div class="cover c' + (b.maSach % 6) + '">' +
          '<span class="cover-title">' + esc(b.tenSach) + '</span>' +
        '</div>';

    var badge = b.doMoiPercent
      ? '<span class="condition-badge mb-1"' +
          (b.tinhTrangVatLy ? ' title="' + esc(b.tinhTrangVatLy) + '"' : '') + '>✓ ' +
          Math.round(b.doMoiPercent) + '% mới</span>'
      : '';

    var giaBia = b.giaBia
      ? '<p class="price-line">Giá bìa: <span>' + OB.formatMoney(b.giaBia) + '</span></p>'
      : '';

    var stock = '';
    if (!conHang) {
      stock = '<p class="small text-danger mb-0">Hết hàng</p>';
    } else if (ton <= 3) {
      stock = '<p class="small text-danger mb-0">Chỉ còn ' + ton + ' cuốn</p>';
    }

    var button = conHang
      ? '<button type="button" class="btn btn-accent btn-sm w-100 mt-2" ' +
          'data-add-to-cart data-requires-login data-so-luong="1" ' +
          'data-ma-sach="' + b.maSach + '">' +
          '<i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ</button>'
      : '<button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-2" disabled>' +
          'Hết hàng</button>';

    return '' +
      '<div class="col-6 col-md-4 col-lg-3">' +
        '<div class="book-card">' +
          cover +
          '<div class="book-info">' +
            badge +
            '<h3 class="book-title"><a href="/books/' + encodeURIComponent(b.maSach) + '" class="text-reset text-decoration-none">' + esc(b.tenSach) + '</a></h3>' +
            '<p class="book-author">Tác giả: ' + esc(b.tacGia || 'Đang cập nhật') + '</p>' +
            '<p class="shop-line mb-1"><i class="bi bi-shop"></i> ' + esc(b.tenCuaHang) + '</p>' +
            giaBia +
            '<p class="price-line">Giá bán: <strong class="price">' + OB.formatMoney(b.giaBanCu) + '</strong></p>' +
            stock +
            button +
          '</div>' +
        '</div>' +
      '</div>';
  }

  function setHeading(p) {
    var title = 'Sách nổi bật';

    if (p.q && p.category) {
      title = 'Kết quả cho "' + p.q + '" trong ' + p.category;
    } else if (p.q) {
      title = 'Kết quả cho "' + p.q + '"';
    } else if (p.category) {
      title = 'Danh mục: ' + p.category;
    }

    $('catalogTitle').textContent = title;

    $('catalogSeeAll').classList.toggle('d-none', !p.q && !p.category);
  }

  function load() {
    var p = params();
    setHeading(p);

    OB.request('GET', buildUrl(p)).then(function (books) {
      hide('catalogLoading');

      if (!books || books.length === 0) {
        $('catalogEmptyText').textContent = (p.q || p.category)
          ? 'Không tìm thấy sách phù hợp.'
          : 'Chưa có sách nào được đăng bán.';
        show('catalogEmpty');
        return;
      }

      grid.innerHTML = books.map(cardHtml).join('');
    }).catch(function (err) {
      hide('catalogLoading');
      $('catalogAlert').textContent = err.message || 'Không tải được danh sách sách.';
      show('catalogAlert');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', load);
  } else {
    load();
  }
})();
</file>

<file path="src/main/resources/templates/books/detail.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title th:text="|${book.tenSach} - OldBook|">Chi tiết sách - OldBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link th:href="@{/css/style.css}" rel="stylesheet">
</head>
<body class="bg-light">
<div th:replace="~{fragments/header :: header}"></div>
<main class="container py-4 min-vh-100">
    <a th:href="@{/books}" class="d-inline-block mb-3">← Danh sách sách</a>
    <article class="card card-body p-4">
        <div class="row g-4">
            <div class="col-md-4">
                <img th:if="${book.hinhAnhUrl != null and (#strings.startsWith(#strings.toLowerCase(book.hinhAnhUrl), 'http://') or #strings.startsWith(#strings.toLowerCase(book.hinhAnhUrl), 'https://') or (#strings.startsWith(book.hinhAnhUrl, '/') and !#strings.startsWith(book.hinhAnhUrl, '//')))}"
                     th:src="${book.hinhAnhUrl}" th:alt="${book.tenSach}" class="img-fluid w-100"
                     style="max-height: 440px; object-fit: contain;">
                <div th:unless="${book.hinhAnhUrl != null and (#strings.startsWith(#strings.toLowerCase(book.hinhAnhUrl), 'http://') or #strings.startsWith(#strings.toLowerCase(book.hinhAnhUrl), 'https://') or (#strings.startsWith(book.hinhAnhUrl, '/') and !#strings.startsWith(book.hinhAnhUrl, '//')))}"
                     class="bg-secondary-subtle d-flex align-items-center justify-content-center text-secondary rounded"
                     style="min-height: 320px;">Chưa có ảnh sách</div>
            </div>
            <div class="col-md-8">
                <p class="text-secondary mb-1" th:text="${book.tenDanhMuc}"></p>
                <h1 class="h3" th:text="${book.tenSach}"></h1>
                <p class="fs-4 text-danger fw-bold" th:if="${book.giaBanCu != null}"
                   th:text="|${#numbers.formatDecimal(book.giaBanCu, 1, 'POINT', 0, 'COMMA')} đ|"></p>
                <p class="text-secondary" th:if="${book.giaBia != null}"
                   th:text="|Giá bìa: ${#numbers.formatDecimal(book.giaBia, 1, 'POINT', 0, 'COMMA')} đ|"></p>
                <dl class="row">
                    <dt class="col-sm-4">Tác giả</dt><dd class="col-sm-8" th:text="${book.tacGia}"></dd>
                    <dt class="col-sm-4">Nhà xuất bản</dt><dd class="col-sm-8" th:text="${book.nhaXuatBan}"></dd>
                    <dt class="col-sm-4">Năm xuất bản</dt><dd class="col-sm-8" th:text="${book.namXuatBan}"></dd>
                    <dt class="col-sm-4">Độ mới</dt><dd class="col-sm-8" th:text="${book.doMoiPercent != null ? book.doMoiPercent + '%' : 'Chưa cập nhật'}"></dd>
                    <dt class="col-sm-4">Tình trạng sách</dt><dd class="col-sm-8" th:text="${book.tinhTrangVatLy}"></dd>
                    <dt class="col-sm-4">Tồn kho</dt><dd class="col-sm-8" th:text="${book.soLuongTon != null and book.soLuongTon > 0 ? book.soLuongTon + ' cuốn' : 'Hết hàng'}"></dd>
                    <dt class="col-sm-4">Cửa hàng</dt>
                    <dd class="col-sm-8"><a th:href="@{/books/tim-kiem(maCH=${book.maCH})}" th:text="${book.tenCuaHang}"></a></dd>
                </dl>
                <button th:if="${book.soLuongTon != null and book.soLuongTon > 0 and book.giaBanCu != null}"
                        type="button" class="btn btn-accent btn-sm mt-2"
                        data-add-to-cart data-requires-login data-so-luong="1"
                        th:attr="data-ma-sach=${book.maSach}">
                    <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                </button>
            </div>
        </div>
        <section class="mt-4 border-top pt-4">
            <h2 class="h5">Mô tả sách</h2>
            <p style="white-space: pre-wrap;" th:text="${book.moTaChiTiet != null ? book.moTaChiTiet : 'Chưa có mô tả.'}"></p>
        </section>
    </article>
</main>
<div th:replace="~{fragments/footer :: footer}"></div>
</body>
</html>
