.condition-badge { display: inline-block; background: var(--bright-300); color: var(--brown-900);
  font-size: .78rem; font-weight: 600; padding: .15rem .55rem; border-radius: 999px; }
.condition-badge i { color: var(--amber-800); }

.user-func a { color: #fff; }
