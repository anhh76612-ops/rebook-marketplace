<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tìm sách cũ - OldBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link th:href="@{/css/style.css}" rel="stylesheet">
</head>
<body class="bg-light">
<div th:replace="~{fragments/header :: header}"></div>
<main class="container py-4 min-vh-100">
    <a th:href="@{/books}" class="d-inline-block mb-3">← Trang sách nổi bật</a>
    <h1 class="h3 mb-3">Tìm sách cũ</h1>
    <form th:action="@{/books/tim-kiem}" th:object="${filters}" method="get" class="card card-body mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="tuKhoa" class="form-label">Tên sách, tác giả hoặc nhà xuất bản</label>
                <input id="tuKhoa" th:field="*{tuKhoa}" maxlength="255" class="form-control" placeholder="Tìm sách bạn muốn đọc">
            </div>
            <div class="col-md-3">
                <label for="maDM" class="form-label">Danh mục</label>
                <select id="maDM" th:field="*{maDM}" class="form-select">
                    <option value="">Tất cả danh mục</option>
                    <option th:each="category : ${categories}" th:value="${category.maDM}" th:text="${category.tenDanhMuc}"></option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="sort" class="form-label">Sắp xếp</label>
                <select id="sort" th:field="*{sort}" class="form-select">
                    <option value="moi-nhat">Mới đăng nhất</option>
                    <option value="cu-nhat">Đăng lâu nhất</option>
                    <option value="gia-tang">Giá tăng dần</option>
                    <option value="gia-giam">Giá giảm dần</option>
                    <option value="ten-az">Tên A–Z</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="giaTu" class="form-label">Giá từ (đ)</label>
                <input id="giaTu" th:field="*{giaTu}" type="number" min="0" step="0.01" class="form-control">
            </div>
            <div class="col-md-3">
                <label for="giaDen" class="form-label">Giá đến (đ)</label>
                <input id="giaDen" th:field="*{giaDen}" type="number" min="0" step="0.01" class="form-control">
            </div>
            <div class="col-md-3">
                <label for="doMoiTu" class="form-label">Độ mới từ (%)</label>
                <input id="doMoiTu" th:field="*{doMoiTu}" type="number" min="0" max="100" step="0.01" class="form-control">
            </div>
            <div class="col-md-3">
                <label for="conHang" class="form-label">Tình trạng kho</label>
                <select id="conHang" th:field="*{conHang}" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="true">Còn hàng</option>
                    <option value="false">Hết hàng</option>
                </select>
            </div>
        </div>
        <input th:if="${filters.maCH != null}" type="hidden" th:field="*{maCH}">
        <input th:if="${filters.doMoiDen != null}" type="hidden" th:field="*{doMoiDen}">
        <input type="hidden" th:field="*{size}">
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Tìm sách</button>
            <a th:href="@{/books/tim-kiem}" class="btn btn-outline-secondary">Xóa bộ lọc</a>
        </div>
    </form>
    <p class="text-secondary" th:text="|${books.totalElements} sách phù hợp|">0 sách phù hợp</p>
    <div th:if="${books.content.isEmpty()}" class="alert alert-light border">
        Không tìm thấy sách phù hợp. Hãy thử từ khóa hoặc bộ lọc khác.
    </div>
    <div class="row g-4">
        <article th:each="book : ${books.content}" class="col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <img th:if="${book.hinhAnhUrl != null and (#strings.startsWith(#strings.toLowerCase(book.hinhAnhUrl), 'http://') or #strings.startsWith(#strings.toLowerCase(book.hinhAnhUrl), 'https://') or (#strings.startsWith(book.hinhAnhUrl, '/') and !#strings.startsWith(book.hinhAnhUrl, '//')))}"
                     th:src="${book.hinhAnhUrl}" th:alt="${book.tenSach}" class="card-img-top p-3" loading="lazy"
                     style="height: 230px; object-fit: contain;">
                <div th:unless="${book.hinhAnhUrl != null and (#strings.startsWith(#strings.toLowerCase(book.hinhAnhUrl), 'http://') or #strings.startsWith(#strings.toLowerCase(book.hinhAnhUrl), 'https://') or (#strings.startsWith(book.hinhAnhUrl, '/') and !#strings.startsWith(book.hinhAnhUrl, '//')))}"
                     class="bg-secondary-subtle d-flex align-items-center justify-content-center text-secondary"
                     style="height: 230px;">Chưa có ảnh sách</div>
                <div class="card-body d-flex flex-column">
                    <h2 class="h6 card-title" th:text="${book.tenSach}"></h2>
                    <p class="small text-secondary mb-1" th:text="${book.tacGia}"></p>
                    <p class="small text-secondary" th:text="${book.tenCuaHang}"></p>
                    <p class="text-danger fw-bold" th:if="${book.giaBanCu != null}"
                       th:text="|${#numbers.formatDecimal(book.giaBanCu, 1, 'POINT', 0, 'COMMA')} đ|"></p>
                    <span th:if="${book.soLuongTon == null or book.soLuongTon <= 0}" class="small text-secondary mb-2">Hết hàng</span>
                    <a th:href="@{/books/{id}(id=${book.maSach})}" class="btn btn-outline-primary btn-sm mt-auto">Xem chi tiết</a>
                    <button th:if="${book.soLuongTon != null and book.soLuongTon > 0 and book.giaBanCu != null}"
                            type="button" class="btn btn-accent btn-sm mt-2"
                            data-add-to-cart data-requires-login data-so-luong="1"
                            th:attr="data-ma-sach=${book.maSach}">
                        <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                    </button>
                </div>
            </div>
        </article>
    </div>
    <nav th:if="${books.totalPages > 1}" aria-label="Phân trang sách" class="mt-4">
        <ul class="pagination justify-content-center align-items-center">
            <li class="page-item" th:classappend="${books.page == 0} ? 'disabled'">
                <a class="page-link" th:href="@{/books/tim-kiem(tuKhoa=${filters.tuKhoa},maDM=${filters.maDM},maCH=${filters.maCH},giaTu=${filters.giaTu},giaDen=${filters.giaDen},doMoiTu=${filters.doMoiTu},doMoiDen=${filters.doMoiDen},conHang=${filters.conHang},sort=${filters.sort},size=${filters.size},page=${books.page - 1})}">Trước</a>
            </li>
            <li class="page-item disabled"><span class="page-link" th:text="|Trang ${books.page + 1} / ${books.totalPages}|"></span></li>
            <li class="page-item" th:classappend="${books.page + 1 >= books.totalPages} ? 'disabled'">
                <a class="page-link" th:href="@{/books/tim-kiem(tuKhoa=${filters.tuKhoa},maDM=${filters.maDM},maCH=${filters.maCH},giaTu=${filters.giaTu},giaDen=${filters.giaDen},doMoiTu=${filters.doMoiTu},doMoiDen=${filters.doMoiDen},conHang=${filters.conHang},sort=${filters.sort},size=${filters.size},page=${books.page + 1})}">Sau</a>
            </li>
        </ul>
    </nav>
</main>
<div th:replace="~{fragments/footer :: footer}"></div>
</body>
</html>
</file>

<file path="src/test/java/com/oldbook/catalog/SachQueryTest.java">
package com.oldbook.catalog;

import com.oldbook.dto.catalog.SachSearchRequest;
import com.oldbook.entity.catalog.CuaHang;
import com.oldbook.entity.catalog.DanhMuc;
import com.oldbook.entity.catalog.Sach;
import com.oldbook.repository.catalog.SachRepository;
import com.oldbook.service.catalog.SachService;
import com.oldbook.exception.common.BusinessException;
import com.oldbook.entity.identity.NguoiDung;
import jakarta.persistence.EntityManager;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.ValueSource;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
import org.springframework.context.annotation.Import;
import org.springframework.test.context.ActiveProfiles;

import java.math.BigDecimal;
import java.util.List;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

@DataJpaTest(showSql = false, properties = "spring.config.import=")
@Import(SachService.class)
@ActiveProfiles({"test", "catalog-test"})
class SachQueryTest {
    @Autowired
    private EntityManager entityManager;
    @Autowired
    private SachService sachService;
    @Autowired
    private SachRepository sachRepository;

    private CuaHang approvedStore;
    private DanhMuc category;
    private int sequence;

    @BeforeEach
    void setUp() {
        approvedStore = store("DA_DUYET");
        category = category("Văn học");
    }

    @Test
    void listAndDetailRequireApprovedBookApprovedStoreAndSellingStatus() {
        var available = book(approvedStore, category, "Công khai", "DA_DUYET", "DANG_BAN", 2, "100", "80");
        var soldOut = book(approvedStore, category, "Hết hàng", "DA_DUYET", "DANG_BAN", 0, "100", "80");
        var hidden = List.of(
                book(approvedStore, category, "Chờ duyệt", "CHO_DUYET", "DANG_BAN", 2, "100", "80"),
                book(approvedStore, category, "Từ chối", "TU_CHOI", "DANG_BAN", 2, "100", "80"),
                book(approvedStore, category, "Ngừng bán", "DA_DUYET", "NGUNG_BAN", 2, "100", "80"),
                book(store("CHO_DUYET"), category, "Shop chờ duyệt", "DA_DUYET", "DANG_BAN", 2, "100", "80"),
                book(store("TU_CHOI"), category, "Shop từ chối", "DA_DUYET", "DANG_BAN", 2, "100", "80")
        );
        entityManager.flush();
        entityManager.clear();

        var page = sachService.search(new SachSearchRequest());

        assertThat(page.content()).extracting(response -> response.maSach())
                .containsExactlyInAnyOrder(available.getMaSach(), soldOut.getMaSach());
        assertThat(sachService.getDetail(soldOut.getMaSach()).soLuongTon()).isZero();
        assertThat(sachService.getDetail(available.getMaSach()).tenCuaHang()).isEqualTo(approvedStore.getTenCuaHang());
        hidden.forEach(sach -> assertThatThrownBy(() -> sachService.getDetail(sach.getMaSach()))
                .isInstanceOf(BusinessException.class));
        assertThatThrownBy(() -> sachService.getDetail(Integer.MAX_VALUE))
                .isInstanceOf(BusinessException.class);
    }

    @Test
    void filtersCombineWithInclusivePriceAndConditionBounds() {
        var matching = book(approvedStore, category, "Sách phù hợp", "DA_DUYET", "DANG_BAN", 3, "120", "75");
        book(approvedStore, category, "Giá thấp", "DA_DUYET", "DANG_BAN", 3, "119", "75");
        book(approvedStore, category, "Độ mới thấp", "DA_DUYET", "DANG_BAN", 3, "120", "74");
        book(approvedStore, category, "Hết hàng", "DA_DUYET", "DANG_BAN", 0, "120", "75");
        book(approvedStore, category("Khoa học"), "Sai danh mục", "DA_DUYET", "DANG_BAN", 3, "120", "75");
        book(store("DA_DUYET"), category, "Sai shop", "DA_DUYET", "DANG_BAN", 3, "120", "75");
        var request = new SachSearchRequest();
        request.setMaCH(approvedStore.getMaCH());
        request.setMaDM(category.getMaDM());
        request.setGiaTu(new BigDecimal("120"));
        request.setGiaDen(new BigDecimal("120"));
        request.setDoMoiTu(new BigDecimal("75"));
        request.setDoMoiDen(new BigDecimal("75"));
        request.setConHang(true);

        assertThat(sachService.search(request).content()).extracting(response -> response.maSach())
                .containsExactly(matching.getMaSach());
    }

    @Test
    void outOfStockFilterIncludesZeroAndLegacyNullStock() {
        var zero = book(approvedStore, category, "Không còn hàng", "DA_DUYET", "DANG_BAN", 0, "100", "80");
        var unknown = book(approvedStore, category, "Chưa nhập tồn kho", "DA_DUYET", "DANG_BAN", null, "100", "80");
        book(approvedStore, category, "Còn hàng", "DA_DUYET", "DANG_BAN", 1, "100", "80");
        var request = new SachSearchRequest();
        request.setConHang(false);

        assertThat(sachService.search(request).content()).extracting(response -> response.maSach())
                .containsExactlyInAnyOrder(zero.getMaSach(), unknown.getMaSach());
    }

    @ParameterizedTest
    @ValueSource(strings = {"%", "_", "[", "\\"})
    void wildcardCharactersAreSearchedLiterally(String keyword) {
        var matching = book(approvedStore, category, "Sách " + keyword + " cụ thể", "DA_DUYET", "DANG_BAN", 1, "100", "80");
        book(approvedStore, category, "Sách thông thường", "DA_DUYET", "DANG_BAN", 1, "100", "80");
        var request = new SachSearchRequest();
        request.setTuKhoa(keyword);

        assertThat(sachService.search(request).content()).extracting(response -> response.maSach())
                .containsExactly(matching.getMaSach());
    }

    @ParameterizedTest
    @ValueSource(strings = {"alpha", "beta", "gamma"})
    void searchIsCaseInsensitiveAcrossTitleAuthorAndPublisher(String keyword) {
        var matching = book(approvedStore, category, "ALPHA", "DA_DUYET", "DANG_BAN", 1, "100", "80");
        matching.setTacGia("BETA");
        matching.setNhaXuatBan("GAMMA");
        book(approvedStore, category, "Không phù hợp", "DA_DUYET", "DANG_BAN", 1, "100", "80");
        var request = new SachSearchRequest();
        request.setTuKhoa("  " + keyword + "  ");

        assertThat(sachService.search(request).content()).extracting(response -> response.maSach())
                .containsExactly(matching.getMaSach());
    }

    @Test
    void paginationAndPriceSortHaveStableIdentifierTieBreaker() {
        var first = book(approvedStore, category, "Một", "DA_DUYET", "DANG_BAN", 1, "100", "80");
        var second = book(approvedStore, category, "Hai", "DA_DUYET", "DANG_BAN", 1, "100", "80");
        book(approvedStore, category, "Ba", "DA_DUYET", "DANG_BAN", 1, "200", "80");
        var request = new SachSearchRequest();
        request.setSort("gia-tang");
        request.setSize(1);

        var page = sachService.search(request);
        assertThat(page.content()).extracting(response -> response.maSach()).containsExactly(first.getMaSach());
        assertThat(page.page()).isZero();
        assertThat(page.size()).isEqualTo(1);
        assertThat(page.totalElements()).isEqualTo(3);
        assertThat(page.totalPages()).isEqualTo(3);
        request.setPage(1);
        assertThat(sachService.search(request).content()).extracting(response -> response.maSach())
                .containsExactly(second.getMaSach());
    }

    @Test
    void categoriesAreReturnedAsDtosSortedByName() {
        category("A category");
        var result = sachService.getDanhMuc();
        assertThat(result).hasSize(2);
        assertThat(result.getFirst().tenDanhMuc()).isEqualTo("A category");
    }

    @Test
    void inventoryRepositoryCanLockTheBookWithinTransaction() {
        var sach = book(approvedStore, category, "Sách", "DA_DUYET", "DANG_BAN", 1, "100", "80");
        entityManager.flush();
        entityManager.clear();
        assertThat(sachRepository.findByIdForUpdate(sach.getMaSach())).isPresent();
    }

    private CuaHang store(String status) {
        int id = ++sequence;
        var owner = NguoiDung.builder().email("catalog-" + id + "@test.local")
                .matKhau("test-hash").hoTen("Chủ shop " + id).build();
        entityManager.persist(owner);
        var store = CuaHang.builder().chuShop(owner).tenCuaHang("Shop " + id)
                .trangThaiDuyet(status).build();
        entityManager.persist(store);
        return store;
    }

    private DanhMuc category(String name) {
        var category = DanhMuc.builder().tenDanhMuc(name).build();
        entityManager.persist(category);
        return category;
    }

    private Sach book(CuaHang store, DanhMuc category, String title, String approval, String selling,
                      Integer stock, String price, String condition) {
        var book = Sach.builder().cuaHang(store).danhMuc(category).tenSach(title)
                .giaBanCu(new BigDecimal(price)).doMoiPercent(new BigDecimal(condition))
                .soLuongTon(stock).trangThaiDuyet(approval).trangThaiBan(selling).build();
        entityManager.persist(book);
        return book;
    }
}
