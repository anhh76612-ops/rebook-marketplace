          <div class="d-flex justify-content-between mb-2"><span>Tạm tính</span><span th:text="${#numbers.formatInteger(total, 1, 'COMMA')} + ' đ'">0 đ</span></div>
          <div class="d-flex justify-content-between mb-2"><span>Giảm giá</span><span>0 đ</span></div>
          <div class="d-flex justify-content-between mb-2"><span>Phí vận chuyển</span><span>20.000 đ</span></div>
