<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<body>

<header th:fragment="header">

  <div class="topbar d-none d-md-block">
    <div class="container d-flex justify-content-between py-1">
      <span>
        <i class="bi bi-telephone me-1"></i>Hotline: 1900 0000
        <i class="bi bi-envelope ms-3 me-1"></i>hotro@oldbook.vn
      </span>

      <span class="user-func">
        <a th:href="@{/wishlist}" data-requires-login>
          <i class="bi bi-heart me-1"></i>Yêu thích
        </a>

        <a th:href="@{/orders}" class="ms-3" data-requires-login>
          <i class="bi bi-truck me-1"></i>Đơn hàng của tôi
        </a>

        <a th:href="@{/login}" class="ms-3" data-auth="guest">
          <i class="bi bi-person me-1"></i>Đăng nhập
        </a>

        <a th:href="@{/register}" class="ms-3" data-auth="guest">
          <i class="bi bi-person-plus me-1"></i>Đăng ký
        </a>

        <span class="ms-3 d-none" data-auth="user">
          <i class="bi bi-person-check me-1"></i><span data-user-name>Tài khoản</span>
        </span>

        <a href="#" class="ms-3 d-none" data-auth="user" data-action="logout">
          <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
        </a>
      </span>
    </div>
  </div>

  <div class="mainbar">
    <div class="container d-flex align-items-center gap-3 py-3">

      <a class="brand" th:href="@{/}">
        <i class="bi bi-book-half"></i> OldBook Marketplace
      </a>

      <form class="search flex-grow-1"
            th:action="@{/books}"
            method="get">

        <input type="text"
               name="q"
               class="form-control"
               placeholder="Tìm sách theo tên, tác giả...">

        <button type="submit" class="btn btn-accent">
          <i class="bi bi-search"></i>
          <span class="d-none d-sm-inline ms-1">Tìm sách</span>
        </button>
      </form>

      <a class="cart-link d-none d-sm-inline-flex"
         th:href="@{/wishlist}"
         data-requires-login
         title="Sản phẩm yêu thích">
        <i class="bi bi-heart"></i>
      </a>

      <a class="cart-link"
         th:href="@{/cart}"
         data-requires-login>
        <i class="bi bi-cart3"></i>
        <span class="cart-count">0</span>
        <span class="d-none d-lg-inline ms-1">Giỏ hàng</span>
      </a>

    </div>
  </div>

  <nav class="menu navbar navbar-expand-lg navbar-dark">
    <div class="container">

      <button class="navbar-toggler ms-auto my-1"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#mainMenu"
              aria-controls="mainMenu"
              aria-expanded="false"
              aria-label="Mở menu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainMenu">

        <ul class="navbar-nav">

          <li class="nav-item">
            <a class="nav-link" th:href="@{/}">
              Trang chủ
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" th:href="@{/books}">
              Tất cả sách
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link"
               th:href="@{/books(category='Kinh tế')}">
              Sách kinh tế
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link"
               th:href="@{/books(category='Văn học')}">
              Sách văn học
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link"
               th:href="@{/books(category='Lịch sử')}">
              Sách lịch sử
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link"
               th:href="@{/books(category='Kỹ năng')}">
              Kỹ năng
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link"
               th:href="@{/books(category='Thiếu nhi')}">
              Thiếu nhi
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link"
               th:href="@{/books(category='Bộ sách')}">
              Bộ sách
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link"
               th:href="@{/orders}"
               data-requires-login>
              <i class="bi bi-truck me-1"></i>
              Theo dõi đơn hàng
            </a>
          </li>

        </ul>

      </div>
    </div>
  </nav>

</header>

</body>
</html>
