<file path="src/main/resources/templates/auth/login.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập - OldBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link th:href="@{/css/style.css}" rel="stylesheet">
</head>
<body>

<div th:replace="~{fragments/header :: header}"></div>

<main class="container">
    <div class="auth-card">
        <h1 class="h4 fw-bold text-center mb-1">Đăng nhập</h1>
        <p class="text-center text-muted mb-4">Đăng nhập để mua bán sách và theo dõi đơn hàng.</p>

        <div id="loginNotice" class="alert alert-info py-2 d-none" role="alert">
            Vui lòng đăng nhập để tiếp tục.
        </div>

        <form id="loginForm" novalidate>
            <div class="mb-3">
                <label for="loginEmail" class="form-label">Email</label>
                <input id="loginEmail" type="email" class="form-control" placeholder="Nhập email"
                       autocomplete="username" required>
            </div>
            <div class="mb-3">
                <label for="loginPassword" class="form-label">Mật khẩu</label>
                <input id="loginPassword" type="password" class="form-control" placeholder="Nhập mật khẩu"
                       autocomplete="current-password" required>
            </div>
            <div id="loginError" class="alert alert-danger py-2 d-none" role="alert"></div>
            <div class="text-end mb-3">
                <a href="#">Quên mật khẩu?</a>
            </div>
            <button type="submit" id="loginBtn" class="btn btn-accent w-100 btn-lg">Đăng Nhập</button>
        </form>

        <div id="rolePicker" class="d-none">
            <p class="text-muted">Tài khoản của bạn có nhiều vai trò. Chọn vai trò để tiếp tục:</p>
            <div id="roleList" class="d-grid gap-2"></div>
            <div id="roleError" class="alert alert-danger py-2 mt-3 d-none" role="alert"></div>
            <button type="button" id="roleBack" class="btn btn-link w-100 mt-2">Quay lại</button>
        </div>

        <p class="text-center mt-4 mb-0">Chưa có tài khoản?
            <a th:href="@{/register}" class="fw-semibold">Đăng ký ngay</a>
        </p>
    </div>
</main>

<div th:replace="~{fragments/footer :: footer}"></div>

<script th:inline="none">
(function () {
    var OB = window.OldBook;
    var Auth = OB.auth;

    var params = new URLSearchParams(window.location.search);
    var hasRedirect = params.has('redirect');
    var target = Auth.safeRedirect(params.get('redirect'), '/');
    if (Auth.isLoggedIn()) {
        window.location.replace(target);
        return;
    }

    if (hasRedirect) {
        document.getElementById('loginNotice').classList.remove('d-none');
    }

    var form = document.getElementById('loginForm');
    var btn = document.getElementById('loginBtn');
    var errBox = document.getElementById('loginError');
    var picker = document.getElementById('rolePicker');
    var roleList = document.getElementById('roleList');
    var roleError = document.getElementById('roleError');

    function showError(box, msg) { box.textContent = msg; box.classList.remove('d-none'); }
    function hideError(box) { box.classList.add('d-none'); }

    function setBusy(busy) {
        btn.disabled = busy;
        btn.textContent = busy ? 'Đang đăng nhập...' : 'Đăng Nhập';
    }
    function finish(data) {
        Auth.saveSession(data);
        return Auth.loadProfileName().then(function () {
            window.location.replace(target);
        });
    }

    function showRolePicker(data) {
        form.classList.add('d-none');
        picker.classList.remove('d-none');
        hideError(roleError);
        roleList.innerHTML = '';

        (data.taiKhoans || []).forEach(function (tk) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'btn btn-outline-brown';
            b.textContent = OB.roleLabels[tk.vaiTro] || tk.vaiTro;
            b.addEventListener('click', function () {
                hideError(roleError);
                b.disabled = true;
                Auth.selectRole(data.roleSelectionToken, tk.maTK).then(finish).catch(function (err) {
                    b.disabled = false;
                    showError(roleError, err.message);
                });
            });
            roleList.appendChild(b);
        });
    }

    document.getElementById('roleBack').addEventListener('click', function () {
        picker.classList.add('d-none');
        form.classList.remove('d-none');
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        hideError(errBox);

        var email = document.getElementById('loginEmail').value.trim();
        var matKhau = document.getElementById('loginPassword').value;

        if (!email || !matKhau) {
            showError(errBox, 'Vui lòng nhập email và mật khẩu');
            return;
        }

        setBusy(true);
        Auth.login(email, matKhau).then(function (data) {
            if (data.canChonVaiTro) {
                showRolePicker(data);
                return null;
            }
            return finish(data);
        }).catch(function (err) {
            showError(errBox, err.message);
        }).then(function () {
            setBusy(false);
        });
    });
})();
</script>
</body>
</html>
</file>

<file path="src/main/resources/templates/cart.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Giỏ hàng - OldBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link th:href="@{/css/style.css}" rel="stylesheet">
</head>
<body data-page-requires-login>

<div th:replace="~{fragments/header :: header}"></div>

<main class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a th:href="@{/}">Trang chủ</a></li>
            <li class="breadcrumb-item active">Giỏ hàng</li>
        </ol>
    </nav>
    <h1 class="h4 fw-bold mb-3">Giỏ hàng của bạn</h1>

    <div id="cartAlert" class="alert alert-danger d-none" role="alert"></div>

    <div id="cartLoading" class="text-center text-muted py-5">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Đang tải giỏ hàng...
    </div>

    <div id="cartWrongRole" class="panel text-center py-5 d-none">
        <i class="bi bi-person-lock fs-1 text-muted"></i>
        <p class="mt-3 mb-3">Giỏ hàng chỉ dành cho tài khoản khách hàng.<br>
            Vui lòng đăng xuất và đăng nhập bằng tài khoản khách hàng.</p>
        <a href="#" class="btn btn-outline-brown" data-action="logout">Đăng xuất</a>
    </div>

    <div id="cartEmpty" class="panel text-center py-5 d-none">
        <i class="bi bi-cart-x fs-1 text-muted"></i>
        <p class="mt-3 mb-3">Giỏ hàng của bạn đang trống.</p>
        <a th:href="@{/books}" class="btn btn-accent">Tiếp tục mua sách</a>
    </div>

    <div id="cartContent" class="row g-4 d-none">
        <div class="col-lg-8">
            <div class="panel p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>Sách</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody id="cartItems"></tbody>
                    </table>
                </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
                <a th:href="@{/books}" class="btn btn-outline-brown"><i class="bi bi-arrow-left me-1"></i>Tiếp tục mua sách</a>
                <button type="button" id="btnClearCart" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Xóa toàn bộ giỏ</button>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel">
                <h2 class="h5 fw-bold mb-3">Tóm tắt đơn hàng</h2>
                <div class="input-group mb-3">
                    <input type="text" class="form-control" placeholder="Mã giảm giá (sắp có)" disabled>
                    <button type="button" class="btn btn-outline-brown" disabled>Áp dụng</button>
                </div>
                <div id="cartNote" class="small text-danger mb-2 d-none">
                    <i class="bi bi-exclamation-triangle me-1"></i>Sản phẩm có cảnh báo không mua được nên không được tính vào tổng tiền.
                </div>
                <div class="d-flex justify-content-between mb-2"><span>Số lượng sách</span><span id="totalQty">0</span></div>
                <div class="d-flex justify-content-between mb-2"><span>Tạm tính</span><span id="subtotal">0 đ</span></div>
                <div class="d-flex justify-content-between mb-2"><span>Giảm giá</span><span>0 đ</span></div>
                <hr>
                <div class="d-flex justify-content-between fs-5 fw-bold mb-3"><span>Tổng cộng</span><span class="price" id="grand">0 đ</span></div>
                <button type="button" class="btn btn-accent btn-lg w-100" disabled title="Chức năng thanh toán sẽ có sau">Thanh toán</button>
            </div>
        </div>
    </div>
</main>

<div th:replace="~{fragments/footer :: footer}"></div>

<script th:inline="none">
(function () {
    var OB = window.OldBook;
    var Auth = OB.auth;
    var Cart = OB.cart;
    var ROLE = OB.ROLE_CUSTOMER;
    if (!Auth.isLoggedIn()) { return; }

    var $ = function (id) { return document.getElementById(id); };
    var busy = false;
    var lastCart = null;

    function show(id) { $(id).classList.remove('d-none'); }
    function hide(id) { $(id).classList.add('d-none'); }

    function showAlert(msg) {
        $('cartAlert').textContent = msg;
        show('cartAlert');
    }
    function safeImg(url) {
        if (!url) { return null; }
        if (/^https?:\/\//i.test(url)) { return url; }
        if (url.charAt(0) === '/' && url.charAt(1) !== '/') { return url; }
        return null;
    }

    function rowHtml(it) {
        var img = safeImg(it.hinhAnhUrl);
        var cover = img
            ? '<img src="' + OB.escapeHtml(img) + '" alt="" class="mini-cover" style="object-fit:cover">'
            : '<div class="mini-cover c' + (it.maSach % 6) + '"></div>';

        var max = Math.min(it.soLuongTon || 0, 999);
        var warn = it.canhBao
            ? '<div class="small text-danger"><i class="bi bi-exclamation-triangle me-1"></i>' + OB.escapeHtml(it.canhBao) + '</div>'
            : '';

        return '' +
        '<tr data-id="' + it.maCTGioHang + '" data-qty="' + it.soLuong + '">' +
          '<td>' +
            '<div class="d-flex align-items-center gap-3">' + cover +
              '<div>' +
                '<div class="fw-semibold text-dark">' + OB.escapeHtml(it.tenSach) + '</div>' +
                '<div class="small text-muted">' + OB.escapeHtml(it.tacGia || 'Đang cập nhật') + '</div>' +
                '<div class="small text-muted"><i class="bi bi-shop me-1"></i>' + OB.escapeHtml(it.tenCuaHang) + '</div>' +
                warn +
              '</div>' +
            '</div>' +
          '</td>' +
          '<td class="text-end">' + OB.formatMoney(it.donGia) + '</td>' +
          '<td class="text-center">' +
            '<div class="input-group input-group-sm qty mx-auto">' +
              '<button type="button" class="btn btn-outline-secondary btn-minus"' + (it.soLuong <= 1 ? ' disabled' : '') + '>−</button>' +
              '<input type="text" class="form-control text-center" value="' + it.soLuong + '" readonly>' +
              '<button type="button" class="btn btn-outline-secondary btn-plus"' + (!it.coTheMua || it.soLuong >= max ? ' disabled' : '') + '>+</button>' +
            '</div>' +
          '</td>' +
          '<td class="text-end fw-semibold">' + OB.formatMoney(it.thanhTien) + '</td>' +
          '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger btn-remove" title="Xóa"><i class="bi bi-trash"></i></button></td>' +
        '</tr>';
    }

    function render(cart) {
        lastCart = cart;
        $('btnClearCart').disabled = false;
        hide('cartLoading');
        hide('cartWrongRole');
        Cart.setBadge(cart.soMuc);

        if (!cart.items || cart.items.length === 0) {
            hide('cartContent');
            show('cartEmpty');
            return;
        }

        hide('cartEmpty');
        $('cartItems').innerHTML = cart.items.map(rowHtml).join('');
        var coDongKhongMua = cart.items.some(function (it) { return !it.coTheMua; });
        $('cartNote').classList.toggle('d-none', !coDongKhongMua);
        $('totalQty').textContent = cart.tongSoLuong;
        $('subtotal').textContent = OB.formatMoney(cart.tongTien);
        $('grand').textContent = OB.formatMoney(cart.tongTien);
        show('cartContent');
    }

    function setBusy(value) {
        busy = value;
        var buttons = document.querySelectorAll('#cartContent button');
        for (var i = 0; i < buttons.length; i++) {
            buttons[i].disabled = value ? true : buttons[i].disabled;
        }
    }

    function load() {
        return Cart.get().then(render).catch(function (err) {
            if (Auth.handleAuthError(err, ROLE)) { return; }
            hide('cartLoading');
            if (err.status === 403) { show('cartWrongRole'); return; }
            showAlert(err.message);
        });
    }
    function run(action) {
        if (busy) { return; }
        hide('cartAlert');
        setBusy(true);

        action().then(function (cart) {
            busy = false;
            render(cart);
        }).catch(function (err) {
            busy = false;
            if (Auth.handleAuthError(err, ROLE)) { return; }
            if (lastCart) { render(lastCart); }
            showAlert(err.message);
            load();
        });
    }

    $('cartItems').addEventListener('click', function (e) {
        var tr = e.target.closest('tr');
        if (!tr) { return; }

        var id = tr.getAttribute('data-id');
        var qty = parseInt(tr.getAttribute('data-qty'), 10);

        if (e.target.closest('.btn-plus')) {
            run(function () { return Cart.update(id, qty + 1); });
        } else if (e.target.closest('.btn-minus')) {
            if (qty > 1) { run(function () { return Cart.update(id, qty - 1); }); }
        } else if (e.target.closest('.btn-remove')) {
            run(function () { return Cart.remove(id); });
        }
    });

    $('btnClearCart').addEventListener('click', function () {
        if (window.confirm('Xóa toàn bộ sản phẩm trong giỏ hàng?')) {
            run(function () { return Cart.clear(); });
        }
    });
    if (!Auth.hasRole(ROLE)) {
        hide('cartLoading');
        show('cartWrongRole');
        return;
    }
    load();
})();
</script>
</body>
</html>
</file>

