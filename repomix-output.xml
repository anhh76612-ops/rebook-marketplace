        <button type="button" class="btn btn-accent" data-bs-dismiss="modal">Lưu tài khoản</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Đổi vai trò -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Thay đổi vai trò</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3">Tài khoản: <strong id="roleModalAccount">—</strong></p>
        <label class="form-label">Vai trò mới</label>
        <select class="form-select" id="roleModalSelect">
          <option>Người dùng</option>
          <option>Chủ cửa hàng</option>
          <option>Đơn vị vận chuyển</option>
          <option>Quản lý</option>
          <option>Quản trị viên</option>
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-accent" data-bs-dismiss="modal">Xác nhận</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal xác nhận xóa tài khoản -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Xóa tài khoản</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Bạn có chắc chắn muốn xóa tài khoản này khỏi hệ thống không?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Xóa</button>
      </div>
    </div>
  </div>
</div>

<footer th:replace="~{fragments/layout :: footer}"></footer>

<script>
  function openRoleModal(code, name, role) {
    document.getElementById('roleModalAccount').textContent = code + ' — ' + name;
    document.getElementById('roleModalSelect').value = role;
  }
</script>
</body>
</html>
</file>

<file path="src/main/resources/templates/books.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head th:replace="~{fragments/layout :: head('Danh sách sách')}"></head>
<body>
<header th:replace="~{fragments/layout :: header}"></header>
<main class="container">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a th:href="@{/}">Trang chủ</a></li>
      <li class="breadcrumb-item active" th:text="${heading}">Sách</li>
    </ol>
  </nav>
  <div class="section-title" style="margin-top:.5rem">
    <h2 th:text="${heading}">Tất cả sách</h2>
    <span class="text-muted" th:text="${#lists.size(books)} + ' cuốn'">0 cuốn</span>
  </div>

  <div class="row g-4">
    <!-- Bộ lọc sách -->
    <div class="col-lg-3">
      <div class="filter-panel mb-3">
        <h3>Tình trạng sách</h3>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="cd1"><label class="form-check-label" for="cd1">Như mới (90–100%)</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="cd2"><label class="form-check-label" for="cd2">Tốt (70–89%)</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="cd3"><label class="form-check-label" for="cd3">Khá (dưới 70%)</label></div>
      </div>
      <div class="filter-panel mb-3">
        <h3>Khoảng giá</h3>
        <div class="form-check"><input class="form-check-input" type="radio" name="price" id="p1"><label class="form-check-label" for="p1">Dưới 50.000 đ</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="price" id="p2"><label class="form-check-label" for="p2">50.000 – 150.000 đ</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="price" id="p3"><label class="form-check-label" for="p3">Trên 150.000 đ</label></div>
      </div>
      <div class="filter-panel mb-3">
        <h3>Đánh giá</h3>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="rt5">
          <label class="form-check-label rating-stars" for="rt5"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i> (5 sao)</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="rt4">
          <label class="form-check-label rating-stars" for="rt4"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i> trở lên</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="rt3">
          <label class="form-check-label rating-stars" for="rt3"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i><i class="bi bi-star"></i> trở lên</label>
        </div>
      </div>
      <div class="filter-panel">
        <h3>Cửa hàng</h3>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="s1"><label class="form-check-label" for="s1">Hiệu sách Minh Thư</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="s2"><label class="form-check-label" for="s2">Nhà sách Ngọc Tuyên</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="s3"><label class="form-check-label" for="s3">Hiệu sách Châu Dưỡng</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="s4"><label class="form-check-label" for="s4">Nhà sách Hoàng Anh</label></div>
      </div>
    </div>

    <!-- Danh sách sách -->
    <div class="col-lg-9">
      <div class="row g-3" th:if="${!books.isEmpty()}">
        <div class="col-6 col-md-4 col-xl-3" th:each="b : ${books}">
          <div th:replace="~{fragments/layout :: card(${b})}"></div>
        </div>
      </div>
      <div class="panel text-center py-5" th:if="${books.isEmpty()}">
        <i class="bi bi-search fs-1 text-muted"></i>
        <p class="mt-2">Không tìm thấy sách phù hợp. Thử từ khóa khác hoặc xem tất cả sách.</p>
        <a th:href="@{/sach}" class="btn btn-accent">Xem tất cả sách</a>
      </div>
    </div>
  </div>
</main>
<footer th:replace="~{fragments/layout :: footer}"></footer>
</body>
</html>
</file>

<file path="src/main/resources/templates/login.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head th:replace="~{fragments/layout :: head('Đăng nhập')}"></head>
<body>
<header th:replace="~{fragments/layout :: header}"></header>
<main class="container">
  <div class="auth-card">
    <h1 class="h4 fw-bold text-center mb-1">Đăng nhập</h1>
    <p class="text-center text-muted mb-4">Đăng nhập để đọc sách và xem giỏ hàng.</p>
    <form th:action="@{/}" method="get">
      <div class="mb-3">
        <label class="form-label">Email hoặc tên đăng nhập</label>
        <input type="text" class="form-control" placeholder="nhap@email.com">
      </div>
      <div class="mb-3">
        <label class="form-label">Mật khẩu</label>
        <input type="password" class="form-control" placeholder="Nhập mật khẩu">
      </div>
      <div class="d-flex justify-content-between mb-3">
        <div class="form-check"><input class="form-check-input" type="checkbox" id="remember"><label class="form-check-label" for="remember">Ghi nhớ đăng nhập</label></div>
        <a href="#">Quên mật khẩu?</a>
      </div>
      <button type="submit" class="btn btn-accent w-100 btn-lg">Đăng nhập</button>
    </form>
    <div class="text-center text-muted my-3">hoặc</div>
    <p class="text-center mt-4 mb-0">Chưa có tài khoản? <a th:href="@{/dang-ky}" class="fw-semibold">Đăng ký ngay</a></p>
  </div>
</main>
<footer th:replace="~{fragments/layout :: footer}"></footer>
</body>
</html>
</file>

<file path="src/main/resources/templates/orders.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head th:replace="~{fragments/layout :: head('Đơn hàng của tôi')}"></head>
<body>
<header th:replace="~{fragments/layout :: header}"></header>
<main class="container">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a th:href="@{/}">Trang chủ</a></li>
      <li class="breadcrumb-item active">Đơn hàng của tôi</li>
    </ol>
  </nav>
  <h1 class="h4 fw-bold mb-3">Đơn hàng của tôi</h1>

  <ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link active" href="#" style="background:var(--accent)">Tất cả</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Chờ xác nhận</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Đang giao</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Hoàn thành</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Đã hủy</a></li>
  </ul>

  <div class="panel mb-3" th:each="o : ${orders}">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <div>
        <strong th:text="'Đơn hàng #' + ${o.code}">Đơn hàng #DH001</strong>
        <span class="text-muted small ms-2" th:text="${o.shop}">Cửa hàng</span>
      </div>
      <span class="condition-badge" th:text="${o.status}">Đang giao</span>
    </div>

    <div class="order-steps">
      <div class="step done"><i class="bi bi-check-circle-fill"></i>Chờ xác nhận</div>
      <div class="step done"><i class="bi bi-check-circle-fill"></i>Đã xác nhận</div>
      <div th:class="${o.stepDone} ? 'step done' : 'step'"><i class="bi bi-truck"></i>Đang giao</div>
      <div class="step"><i class="bi bi-box-seam"></i>Đã giao</div>
    </div>

    <div class="d-flex align-items-center gap-3 mb-2" th:each="b : ${o.books}">
      <div class="mini-cover" th:classappend="'c' + ${b.id % 6}"></div>
      <div class="flex-grow-1">
        <div class="fw-semibold" th:text="${b.title}">Tên sách</div>
        <div class="small text-muted" th:text="${#numbers.formatInteger(b.ebookPrice, 1, 'COMMA')} + ' đ'">0 đ</div>
      </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
      <span class="fw-bold" th:text="'Tổng: ' + ${#numbers.formatInteger(o.total, 1, 'COMMA')} + ' đ'">Tổng: 0 đ</span>
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal">Gửi yêu cầu hủy</button>
        <a th:href="@{/sach}" class="btn btn-accent btn-sm">Mua lại</a>
      </div>
    </div>
  </div>

  <!-- Modal gửi yêu cầu hủy đơn -->
  <div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Gửi yêu cầu hủy đơn</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">Lý do hủy đơn</label>
          <textarea class="form-control" rows="3" placeholder="Nhập lý do..."></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="button" class="btn btn-accent" data-bs-dismiss="modal">Gửi yêu cầu</button>
        </div>
      </div>
    </div>
