# Mẫu cấu hình cho máy local. Chép file này thành ".env" rồi điền giá trị của bạn.
# File ".env" không được đưa lên git (đã nằm trong .gitignore). Đừng điền bí mật vào file mẫu này.

# ===============================
# SQL SERVER
# ===============================
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=oldbook_db;encrypt=false;trustServerCertificate=true
DB_USERNAME=
DB_PASSWORD=

# ===============================
# GMAIL SMTP - dùng Mật khẩu ứng dụng của Gmail
# ===============================
MAIL_USERNAME=
MAIL_PASSWORD=

# ===============================
# CLOUDINARY
# ===============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===============================
# THANH TOÁN CHUYỂN KHOẢN (VietQR + Casso) - xem docs/payment.md
# Bỏ trống ba dòng payment.bank.* thì trang thanh toán chỉ còn COD.
# ===============================
# Tài khoản ngân hàng của sàn: mã BIN 6 số của ngân hàng (ví dụ MB Bank là 970422), số tài khoản, tên chủ tài khoản.
payment.bank.bin=
payment.bank.account-no=
payment.bank.account-name=
# Khóa kiểm chữ ký webhook. Máy local: một chuỗi ngẫu nhiên bất kỳ (ví dụ kết quả của "openssl rand -hex 24").
# Khi nối Casso thật: "Key bảo mật" của tích hợp Webhook V2.
payment.casso.checksum-key=
payment.session-minutes=5
